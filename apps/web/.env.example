VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_PROVIDER=oidc
VITE_OIDC_AUTHORITY=https://identity.example.test
VITE_OIDC_CLIENT_ID=jewelai-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_AUDIENCE=https://api.example.test
# For Identity Platform development, set VITE_AUTH_PROVIDER=identity_platform and provide:
# VITE_IDENTITY_PLATFORM_API_KEY=<public Firebase web API key>
# VITE_IDENTITY_PLATFORM_AUTH_DOMAIN=<project>.firebaseapp.com
# VITE_IDENTITY_PLATFORM_PROJECT_ID=<project>
# VITE_IDENTITY_PLATFORM_APP_ID=<Firebase web app ID>
