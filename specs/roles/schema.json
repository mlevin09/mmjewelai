{
  "$defs": {
    "RoleId": {
      "enum": [
        "RR-C02",
        "RR-C04",
        "RR-C06",
        "RR-C09",
        "RR-C10",
        "RR-C11",
        "RR-C12",
        "RR-C14",
        "RR-C15",
        "RR-C16",
        "RR-C17",
        "RR-C18",
        "RR-C20",
        "RR-C21",
        "RR-C26",
        "RR-C22",
        "RR-C27",
        "RR-C28",
        "RR-C23",
        "RR-C24",
        "RR-C25"
      ],
      "title": "RoleId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "role_id": {
      "$ref": "#/$defs/RoleId"
    },
    "name_ru": {
      "minLength": 1,
      "title": "Name Ru",
      "type": "string"
    },
    "name_en": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name En"
    },
    "status": {
      "enum": [
        "active",
        "inactive"
      ],
      "title": "Status",
      "type": "string"
    },
    "merged_from_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Merged From Ids",
      "type": "array"
    },
    "role_data": {
      "additionalProperties": true,
      "title": "Role Data",
      "type": "object"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "authorization_effect": {
      "const": "none",
      "default": "none",
      "title": "Authorization Effect",
      "type": "string"
    }
  },
  "required": [
    "role_id",
    "name_ru",
    "status",
    "role_data",
    "revision"
  ],
  "title": "RoleProfile",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jewelai:current-role-definition"
}
