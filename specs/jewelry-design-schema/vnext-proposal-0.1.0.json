      "covers": [
        "alloy_system",
        "coating",
        "surface_treatment",
        "components"
      ]
    },
    {
      "model": "ProductConstructionExtension",
      "covers": [
        "ring",
        "earring",
        "pendant",
        "necklace",
        "bracelet",
        "brooch",
        "head",
        "shoulders",
        "bridge",
        "sizing_area",
        "shank_configuration",
        "solidity"
      ]
    },
    {
      "model": "ProductDimensions",
      "covers": [
        "product.overall_dimensions",
        "product.dimension_scope",
        "product-specific dimensions"
      ]
    },
    {
      "model": "StyleDesignSemantics",
      "covers": [
        "style_period_or_movement",
        "style_influences",
        "style_descriptors",
        "decorative_elements",
        "composition"
      ]
    }
  ],
  "migration_rules": [
    {
      "from": "1.0.0",
      "to": "1.1.0",
      "rule": "Existing snapshots remain valid 1.0.0 artifacts; no in-place mutation."
    },
    {
      "from": "style",
      "to": "style + style/design semantic extensions",
      "rule": "Do not infer historical period, decorative technique, motif, composition, or creative intent from an existing style ID."
    },
    {
      "from": "references",
      "to": "reference binding contract",
      "rule": "Existing AssetReference objects remain unchanged; feature bindings link by asset_id and do not rewrite reference purpose/note."
    },
    {
      "from": "visual_constraints",
      "to": "AI Generation State / Verification",
      "rule": "Do not reinterpret free-form visual constraints as passed verification checks."
    },
    {
      "from": "side_stones",
      "to": "extended side-stone semantics",
      "rule": "Preserve stable group_id; extensions attach only to existing groups unless a separate user-authorized group creation occurs."
    }
  ],
  "excluded_from_product_state": {
    "interpretation_metadata": [
      "creative_intent",
      "proportions.scale_anchor",
      "creative_intent_raw",
      "creative_intent_descriptors",
      "creative_intent_axes"
    ],
    "reference_binding": [
      "references.feature_bindings"
    ],
    "ai_generation_state": [
      "presentation.camera_view",
      "presentation.lighting",
      "presentation.scale"
    ],
    "output_profile": [
      "presentation.framing",
      "presentation.background",
      "presentation.realism",
      "presentation.additional_views"
    ],
    "verification_result": [
      "verification.geometry_plausibility",
      "verification.metal_realism",
      "verification.stone_realism",
      "verification.common_errors"
    ],
    "derived_runtime_metadata": [
      "proportions.relative_ratios"
    ]
  },
  "freeze_gate": {
    "normative": false,
    "reason": "Exact reconstructed target IDs must be reconciled with the original 56-target Matrix and P0-1..P0-9 source artifacts before schema freeze."
  }
}
