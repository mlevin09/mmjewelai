{
  "proposal_id": "jewelai.jewelry_design_schema.vnext.p0_15",
  "proposal_version": "0.1.0",
  "proposed_schema_version": "1.1.0",
  "status": "DRAFT_NOT_NORMATIVE",
  "compatibility": "ADDITIVE_MINOR_VERSION_PROPOSAL",
  "principles": [
    "All Jewelry Design Schema v1.0.0 fields and meanings remain unchanged.",
    "New fields are optional/additive; no historical revision is silently migrated.",
    "Reference feature bindings, AI presentation state, and verification results are separate contracts.",
    "Creative-intent raw/normalized axes are interpretation metadata and do not become objective Product State facts.",
    "Repeated product components require stable IDs; array position is never identity.",
    "No quantitative value may be invented from qualitative wording or unscaled imagery."
  ],
  "current_v1_target_count": 30,
  "candidate_product_state_vnext_target_count": 118,
  "proposed_nested_models": [
    {
      "model": "StoneSemanticsExtension",
      "covers": [
        "variety_or_type",
        "material_origin_status",
        "geographic_origin",
        "treatment_status",
        "treatments",
        "cut_style_class"
      ]
    },
    {
      "model": "SideStonePopulationExtension",
      "covers": [
        "role",
        "arrangement",
        "location",
        "coverage",
        "total_carat_weight",
        "sieve_system",
        "sieve_designation",
        "diameter_range_mm"
      ]
    },
    {
      "model": "ProngConfiguration",
      "covers": [
        "prong_count",
        "prong_style",
        "prong_configuration"
      ]
    },
    {
      "model": "HaloState",
      "covers": [
        "enabled",
        "type",
        "location",
        "row_count",
        "outline_relation"
      ]
    },
    {
      "model": "PaveState",
      "covers": [
        "enabled",
        "location",
        "coverage",
        "row_count"
      ]
    },
    {
