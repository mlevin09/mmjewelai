{
  "$defs": {
    "CompiledPrompt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "compiler_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Compiler Version",
          "type": "string"
        },
        "template_id": {
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "title": "Template Id",
          "type": "string"
        },
        "template_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Template Version",
          "type": "string"
        },
        "template_artifact_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Template Artifact Version",
          "type": "string"
        },
        "specification_revision_id": {
          "format": "uuid",
          "title": "Specification Revision Id",
          "type": "string"
        },
        "design_id": {
          "format": "uuid",
          "title": "Design Id",
          "type": "string"
        },
        "design_schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Design Schema Version",
          "type": "string"
        },
        "prompt_text": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Prompt Text",
          "type": "string"
        },
        "specification_entries": {
          "items": {
            "$ref": "#/$defs/SpecificationEntry"
          },
          "title": "Specification Entries",
          "type": "array"
        },
        "locked_constraints": {
          "items": {
            "$ref": "#/$defs/PromptConstraint"
          },
          "title": "Locked Constraints",
          "type": "array"
        },
        "disclosures": {
          "items": {
            "$ref": "#/$defs/PromptDisclosure"
          },
          "title": "Disclosures",
          "type": "array"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "template_version",
        "template_artifact_version",
        "specification_revision_id",
        "design_id",
        "design_schema_version",
        "prompt_text",
        "specification_entries",
        "locked_constraints",
        "disclosures",
        "content_hash"
      ],
      "title": "CompiledPrompt",
      "type": "object"
    },
    "JsonValue": {},
    "PromptConstraint": {
      "additionalProperties": false,
      "properties": {
        "concrete_target": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Concrete Target",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "value",
            "not_applicable"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "concrete_target",
        "applicability"
      ],
      "title": "PromptConstraint",
      "type": "object"
    },
    "PromptDisclosure": {
      "additionalProperties": false,
      "properties": {
        "concrete_target": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Concrete Target",
          "type": "string"
        },
        "origin": {
          "enum": [
            "derived",
            "assumed",
            "not_applicable"
          ],
          "title": "Origin",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptSourceReference"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "concrete_target",
        "origin"
      ],
      "title": "PromptDisclosure",
      "type": "object"
    },
    "PromptSourceReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "knowledge",
            "rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "identifier": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Identifier",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identifier",
        "version"
      ],
      "title": "PromptSourceReference",
      "type": "object"
    },
    "PromptTemplate": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "title": "Template Id",
          "type": "string"
        },
        "template_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Template Version",
          "type": "string"
        },
        "purpose": {
          "const": "jewelry_visualization",
          "title": "Purpose",
          "type": "string"
        },
        "output_language": {
          "const": "en",
          "title": "Output Language",
          "type": "string"
        },
        "introduction": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Introduction",
          "type": "string"
        },
        "instructions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Instructions",
          "type": "array"
        },
        "labels": {
          "$ref": "#/$defs/TemplateLabels"
        }
      },
      "required": [
        "template_id",
        "template_version",
        "purpose",
        "output_language",
        "introduction",
        "instructions",
        "labels"
      ],
      "title": "PromptTemplate",
      "type": "object"
    },
    "PromptTemplateBundle": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Artifact Version",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/TemplateProvenance"
        },
        "templates": {
          "items": {
            "$ref": "#/$defs/PromptTemplate"
          },
          "minItems": 1,
          "title": "Templates",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "artifact_version",
        "provenance",
        "templates"
      ],
      "title": "PromptTemplateBundle",
      "type": "object"
    },
    "SpecificationEntry": {
      "additionalProperties": false,
      "properties": {
        "concrete_target": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Concrete Target",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "value",
            "not_applicable"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "origin": {
          "enum": [
            "explicit",
            "derived",
            "assumed"
          ],
          "title": "Origin",
          "type": "string"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "locked": {
          "title": "Locked",
          "type": "boolean"
        }
      },
      "required": [
        "concrete_target",
        "applicability",
        "origin",
        "confirmed",
        "locked"
      ],
      "title": "SpecificationEntry",
      "type": "object"
    },
    "TemplateLabels": {
      "additionalProperties": false,
      "properties": {
        "specification": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Specification",
          "type": "string"
        },
        "locked_constraints": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Locked Constraints",
          "type": "string"
        },
        "disclosures": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Disclosures",
          "type": "string"
        }
      },
      "required": [
        "specification",
        "locked_constraints",
        "disclosures"
      ],
      "title": "TemplateLabels",
      "type": "object"
    },
    "TemplateProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "const": "repository_spec",
          "default": "repository_spec",
          "title": "Source Kind",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Ref",
          "type": "string"
        },
        "review_status": {
          "const": "proposed_pending_product_review",
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "review_status"
      ],
      "title": "TemplateProvenance",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/PromptTemplateBundle"
    },
    {
      "$ref": "#/$defs/CompiledPrompt"
    }
  ]
}
