      "question_id": "CENTER_STONE_SHAPE",
      "target": "center_stone.shape",
      "answer_contract": {
        "kind": "dictionary_id",
        "schema_type": "DomainId",
        "dictionary_category": "stone_shape"
      },
      "wording": {
        "en": "What shape would you like for the center stone?",
        "ru": "Какую форму центрального камня вы хотели бы выбрать?"
      },
      "examples": [
        {
          "description": {
            "en": "A valid answer is the stone-shape dictionary ID oval.",
            "ru": "Допустимый ответ — идентификатор oval из категории форм камня."
          },
          "dictionary_id": "oval"
        }
      ],
      "provenance": {
        "source_kind": "repository_spec",
        "source_ref": "docs/product/issues/04-questions.md",
        "review_status": "proposed_pending_domain_review"
      }
