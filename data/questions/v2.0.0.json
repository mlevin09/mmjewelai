      "target": "center_stone.dimensions",
      "answer_contract": {
        "kind": "dimensions",
        "schema_type": "Dimensions",
        "unit": "mm",
        "components": [
          "length",
          "width",
          "depth"
        ]
      },
      "wording": {
        "en": "What are the center stone's length, width, and depth in millimetres?",
        "ru": "Каковы длина, ширина и глубина центрального камня в миллиметрах?"
      },
      "examples": [
        {
          "description": {
            "en": "Return a Dimensions value with positive length, width, and depth Length fields in mm.",
            "ru": "Верните значение Dimensions с положительными полями Length для длины, ширины и глубины в мм."
          }
        }
      ],
      "provenance": {
        "source_kind": "repository_spec",
        "source_ref": "docs/product/issues/04-questions.md",
        "review_status": "proposed_pending_domain_review"
